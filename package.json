{
  "name": "empfang-ki",
  "version": "0.1.0",
  "description": "KI-Empfangsassistent für kleine Unternehmen – einbettbares Chat-Widget mit Wissensbasis, Anfrage-Erfassung und Branchen-Vorlagen",
  "type": "module",
  "main": "server/src/index.js",
  "scripts": {
    "start": "node server/src/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/src/index.js",
    "migrate": "node --env-file-if-exists=.env server/src/scripts/migrate.js",
    "seed": "node --env-file-if-exists=.env server/src/scripts/seed.js",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Alfred Mushagalusa Munganga",
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "cheerio": "^1.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "stripe": "^23.0.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  }
}
