# Kopieren nach .env und ausfüllen:  cp .env.example .env

NODE_ENV=production
# Port, auf dem die App lokal lauscht (Caddy leitet empfang-ki.de hierhin weiter)
PORT=3010

# Öffentliche Adresse der App (ohne / am Ende)
PUBLIC_URL=https://empfang-ki.de

# Datenbank – ohne Docker (PostgreSQL direkt auf dem Server):
DATABASE_URL=postgres://empfang:PASSWORT@localhost:5432/empfang
# Nur für docker-compose:
# POSTGRES_PASSWORD=bitte-ein-langes-zufaelliges-passwort

# Anthropic API (https://console.anthropic.com). Ohne Key läuft der Mock-Modus.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5

# Schützt die Admin-API (/api/admin). Langer Zufallswert, z. B.: openssl rand -hex 32
ADMIN_TOKEN=

# E-Mail-Versand für neue Anfragen (z. B. IONOS-Postfach). Leer = nur Log-Ausgabe.
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_USER=support@empfang-ki.de
SMTP_PASS=
MAIL_FROM="Empfang KI <support@empfang-ki.de>"
# Optional: Antworten auf System-Mails hierhin (z. B. wenn MAIL_FROM ein reiner Versand-Absender ist)
MAIL_REPLY_TO=
# Wer Erinnerungen bekommt (z. B. „Gründerpreis endet“). Leer = Adresse aus MAIL_FROM
ADMIN_EMAIL=

# Gespräche nach X Tagen löschen
RETENTION_DAYS=30

# Testphase für neue Kunden in Tagen
TRIAL_DAYS=14

# Stripe (optional – ohne Stripe nur manuelle Zahlung). Anleitung: README → "Stripe einrichten"
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_PRO=
# Reguläre Preise 49 / 99 / 179 € (für Kunden nach den ersten 10 Gründerkunden)
STRIPE_PRICE_STARTER_REGULAR=
STRIPE_PRICE_BUSINESS_REGULAR=
STRIPE_PRICE_PRO_REGULAR=

# Wissenssuche (große Wissensbasen): hybride Suche = Volltext + semantische Suche (Embeddings)
# local = Embedding-Modell lokal auf der CPU (keine Daten an Dritte), none = nur Volltextsuche
EMBEDDINGS_PROVIDER=local
# Mehrsprachiges Modell (DE/EN/FR …); wird beim ersten Start einmalig heruntergeladen (ca. 120 MB)
EMBEDDINGS_MODEL=Xenova/multilingual-e5-small
# Ohne Docker: Ordner für das heruntergeladene Modell (leer = Standard im node_modules-Ordner)
EMBEDDINGS_CACHE_DIR=
# Bis zu dieser Größe (Tokens) kommt die ganze Wissensbasis in den Prompt, darüber wird gesucht
KNOWLEDGE_FULL_CONTEXT_TOKENS=24000
