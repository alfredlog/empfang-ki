# Kopieren nach .env und ausfüllen:  cp .env.example .env

# Öffentliche Adresse der App (ohne / am Ende)
PUBLIC_URL=https://chatbot.pdf-libre.de

# Datenbank-Passwort (für docker-compose). Lokal ohne Docker stattdessen DATABASE_URL setzen.
POSTGRES_PASSWORD=bitte-ein-langes-zufaelliges-passwort
# DATABASE_URL=postgres://empfang:empfang@localhost:5432/empfang

# Anthropic API (https://console.anthropic.com). Ohne Key läuft der Mock-Modus.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5

# Schützt die Admin-API (/api/admin). Langer Zufallswert, z. B.: openssl rand -hex 32
ADMIN_TOKEN=

# E-Mail-Versand für neue Anfragen (z. B. IONOS-Postfach). Leer = nur Log-Ausgabe.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Empfang KI <no-reply@pdf-libre.de>"

# Gespräche nach X Tagen löschen
RETENTION_DAYS=30
