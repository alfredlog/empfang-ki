# Kopieren nach .env und ausfüllen:  cp .env.example .env

NODE_ENV=production
# Port, auf dem die App lokal lauscht (Caddy leitet empfang-ki.de hierhin weiter)
PORT=3010

# Öffentliche Adresse der App (ohne / am Ende)
PUBLIC_URL=https://empfang-ki.de

# Datenbank – ohne Docker (PostgreSQL direkt auf dem Server):
DATABASE_URL=postgres://empfang:PASSWORT@localhost:5432/empfang
# Nur für docker-compose:
# POSTGRES_PASSWORD=bitte-ein-langes-zufaelliges-passwort

# Anthropic API (https://console.anthropic.com). Ohne Key läuft der Mock-Modus.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5

# Schützt die Admin-API (/api/admin). Langer Zufallswert, z. B.: openssl rand -hex 32
ADMIN_TOKEN=

# E-Mail-Versand für neue Anfragen (z. B. IONOS-Postfach). Leer = nur Log-Ausgabe.
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_USER=support@pdf-libre.de
SMTP_PASS=
MAIL_FROM="Empfang KI <support@pdf-libre.de>"

# Gespräche nach X Tagen löschen
RETENTION_DAYS=30

# Testphase für neue Kunden in Tagen
TRIAL_DAYS=14

# Stripe (optional – ohne Stripe nur manuelle Zahlung). Anleitung: README → "Stripe einrichten"
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_PRO=
